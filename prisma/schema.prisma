datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ユーザー
// ============================================================
model UserProfile {
  id           String            @id @default(cuid())
  userId       String            @unique // 認証プロバイダ由来のID。将来のSCAD共通アカウント統合を見据え外部IDを保持
  displayName  String
  soloRank     SoloRank          @default(BEGINNER)
  visitCount   Int               @default(0)
  visitLogs    VisitLog[]
  achievements UserAchievement[]
  createdAt    DateTime          @default(now())
}

// ============================================================
// スポット(恒常的に存在する場所)
// ============================================================
model Spot {
  id               String     @id @default(cuid())
  name             String
  category         Category // 大分類
  // 小分類タグ。場所の種類("カラオケ","サウナ")と店選びの基準("立ち飲み","日本酒",
  // "ワイン","ビール","女性ひとり歓迎")を同じ配列で持ち、検索フィルターと1対1で対応させる
  subCategories    String[]   @default([])
  address          String
  // 推し文。「一人客が7割のカウンター」のような一言で、カードに出して決め手にする。
  // AI検索で店を取り込む際は、店の情報と一緒にこの一言も生成させる
  tagline          String?
  latitude         Float
  longitude        Float
  hasCounterSeat   Boolean    @default(true)
  senberoAvailable Boolean    @default(false)
  soloFriendliness Int        @default(5) // 1-10
  visitLogs        VisitLog[]
  events           Event[]
  createdAt        DateTime   @default(now())

  // 実店舗データ収集(AI検索での発掘)と閉店確認の月次バッチ用のメタ情報
  nearestStation String? // 収集計画(駅ごとの件数ノルマ)の集計キー
  googlePlaceId  String?     @unique // Places APIで営業状態(閉店)を確認するための紐付け
  status         SpotStatus  @default(ACTIVE)
  lastVerifiedAt DateTime? // 最後にPlaces APIで営業状態を確認した日時
  sourceNote     String? // どうやって見つけたか(検索クエリ・出典URL等)。人力レビューの参考用

  @@index([category])
  @@index([latitude, longitude])
  @@index([subCategories], type: Gin) // 配列タグ検索用
  @@index([nearestStation])
  @@index([status])
}

// ============================================================
// イベント(期間限定の催し。Spotとはライフサイクルが異なるため分離)
// ============================================================
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  imageUrl    String?
  tags        String[] @default([]) // "美術館","花火","オープン" 等

  // 店舗に紐づくイベント(任意)
  spotId String?
  spot   Spot?   @relation(fields: [spotId], references: [id])

  // 店舗に紐づかない屋外イベント用
  address   String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())

  @@index([startDate, endDate]) // 「開催中のみ表示」「終了後は自動非表示」用
  @@index([latitude, longitude])
}

// ============================================================
// 来店ログ
// ============================================================
model VisitLog {
  id        String      @id @default(cuid())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [userId])
  spotId    String
  spot      Spot        @relation(fields: [spotId], references: [id])
  // ユーザーが自分用に残すメモ(使った金額・誰と会ったか等)。後から編集できる
  comment   String?
  imageUrl  String?
  visitedAt DateTime    @default(now())

  @@index([userId, spotId]) // 同一店の来店回数集計(常連判定)用
}

// ============================================================
// 実績(記念日・常連バッジ・将来のバッジをすべてここで扱う)
// key の例: "visit:10" (来店10回) / "regular:<spotId>" (同一店3回) / "days:100" (初来店から100日)
// ============================================================
model UserAchievement {
  id         String      @id @default(cuid())
  userId     String
  user       UserProfile @relation(fields: [userId], references: [userId])
  key        String
  label      String
  achievedAt DateTime    @default(now())
  notified   Boolean     @default(false) // 未通知の実績だけをバナー表示する

  @@unique([userId, key]) // 同じ実績を二重付与しない
  @@index([userId, notified])
}

enum Category {
  SOLO_NOMI
  SOLO_MESHI
  SOLO_SPOT
}

enum SoloRank {
  BEGINNER // 1〜3回
  REGULAR // 4〜9回
  MASTER // 10回以上
}

enum SpotStatus {
  ACTIVE // 通常表示
  NEEDS_REVIEW // Places APIで営業状態が怪しいと判定され、人力確認待ち
  CLOSED // 閉業確認済み。検索結果から除外
}
